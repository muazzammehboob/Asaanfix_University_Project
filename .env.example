# FixIt Hub Pakistan - Environment Configuration
# Copy this file to .env and update values for your environment

# Application
APP_NAME=FixIt Hub Pakistan
APP_VERSION=2.0.0
APP_URL=http://localhost:8000
APP_ENV=development
APP_DEBUG=true

# Database
DB_HOST=localhost
DB_NAME=fixithub_pakistan
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Email
APP_EMAIL=info@fixithub.pk
APP_PHONE=+92 300 1234567
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=info@fixithub.pk

# Security
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_STRING
CSRF_TOKEN_NAME=csrf_token
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Payment Gateways (Pakistan)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_SANDBOX=true
JAZZCASH_ENDPOINT=https://sandbox.jazzcash.com.pk/ApplicationAPI/API/Payment/DoTransaction

EASYPAISA_STORE_ID=
EASYPAISA_TOKEN=
EASYPAISA_SANDBOX=true
EASYPAISA_ENDPOINT=https://easypay.easypaisa.com.pk/easypay/Index.jsf

# Cache
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_DIR=cache

# Uploads
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Google (SEO/Analytics)
GOOGLE_ANALYTICS_ID=
GOOGLE_SITE_VERIFICATION=
